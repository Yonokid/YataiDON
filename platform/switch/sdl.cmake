set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_HIDAPI OFF CACHE BOOL "" FORCE)
set(SDL_VIRTUAL_JOYSTICK ON CACHE BOOL "" FORCE)
set(SDL_PTHREADS ON CACHE BOOL "" FORCE)
set(SDL_PTHREADS_SEM ON CACHE BOOL "" FORCE)
set(SDL_CPUINFO ON CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL2_DISABLE_SDL2MAIN ON CACHE BOOL "" FORCE)
foreach(feature OPENGL OPENGLES VULKAN RENDER HAPTIC SENSOR LOADSO)
  set(SDL_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${vendor}/SDL" "${CMAKE_BINARY_DIR}/sdl" EXCLUDE_FROM_ALL)
